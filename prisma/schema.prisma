generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanTier {
  FREE
  PREMIUM
}

enum CandidateStage {
  STUDENT
  INTERN
  FRESHER
  EXPERIENCED
}

enum MarketFocus {
  INDIA
  INTERNATIONAL
  BOTH
}

enum InterviewMode {
  HR
  TECHNICAL
  BEHAVIORAL
  SALARY
  RESUME_MATCH
  COMPANY_PREP
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MessageRole {
  SYSTEM
  AI
  USER
}

enum ReadinessLevel {
  NEEDS_FOUNDATION
  DEVELOPING
  MODERATE
  STRONG
  INTERVIEW_READY
}

enum UsageEventType {
  DEMO_EVALUATION
  INTERVIEW_QUESTION
  INTERVIEW_EVALUATION
  SALARY_EVALUATION
  RESUME_MATCH
  COMPANY_PREP
  WEEKLY_REPORT
  CERTIFICATE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  planTier      PlanTier  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        Profile?
  interviews     InterviewSession[]
  evaluations    AnswerEvaluation[]
  resumeMatches  ResumeMatch[]
  weeklyReports  WeeklyReport[]
  certificates   ReadinessCertificate[]
  usageEvents    UsageEvent[]
  streak          UserStreak?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                String         @id @default(cuid())
  userId            String         @unique
  fullName          String
  candidateStage    CandidateStage
  targetRole        String
  targetField       String
  experienceYears   Int            @default(0)
  skills            String[]
  preferredLocation String?
  marketFocus       MarketFocus    @default(BOTH)
  salaryCurrency    String         @default("INR")
  expectedSalaryMin Int?
  expectedSalaryMax Int?
  targetCompanies   String[]
  interviewGoal     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id          String        @id @default(cuid())
  userId      String?
  demoId      String?
  mode        InterviewMode
  difficulty  Difficulty
  targetRole  String
  targetField String?
  company     String?
  marketFocus MarketFocus    @default(BOTH)
  status      SessionStatus  @default(ACTIVE)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    InterviewMessage[]
  evaluations AnswerEvaluation[]

  @@index([userId, createdAt])
  @@index([demoId])
}

model InterviewMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model AnswerEvaluation {
  id                       String          @id @default(cuid())
  userId                   String?
  sessionId                String
  question                 String          @db.Text
  answer                   String          @db.Text
  overallScore             Int
  categoryScores           Json
  strengths                String[]
  weaknesses               String[]
  improvedAnswer           String          @db.Text
  readinessLevel           ReadinessLevel
  estimatedSelectionChance Int
  nextPracticeStep         String
  rubricVersion            String
  promptVersion            String
  model                    String?
  metadata                 Json?
  createdAt                DateTime        @default(now())

  user    User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model ResumeMatch {
  id                  String   @id @default(cuid())
  userId              String
  resumeText          String   @db.Text
  jobDescriptionText  String   @db.Text
  targetRole          String
  matchScore          Int
  matchedSkills       String[]
  missingSkills       String[]
  recommendations     String[]
  rawFeedback         Json?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WeeklyReport {
  id                String   @id @default(cuid())
  userId            String
  weekStart         DateTime
  averageScore      Int
  readinessLevel    ReadinessLevel
  strongestAreas    String[]
  weakestAreas      String[]
  recommendedActions String[]
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model ReadinessCertificate {
  id             String         @id @default(cuid())
  userId         String
  certificateNo  String         @unique
  targetRole     String
  readinessScore Int
  readinessLevel ReadinessLevel
  issuedAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issuedAt])
}

model UserStreak {
  id              String   @id @default(cuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastPracticeDate DateTime?
  points          Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id            String         @id @default(cuid())
  userId        String?
  demoId        String?
  eventType     UsageEventType
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?
  metadata      Json?
  createdAt     DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([demoId, createdAt])
  @@index([eventType, createdAt])
}
