# ==========================================
# Python Backend Environment Configuration
# ==========================================

# Application Settings
APP_ENV=development
APP_DEBUG=true
HOST=0.0.0.0
PORT=8000

# Allowed hosts for production
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicareerforge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7
BCRYPT_ROUNDS=12

# AI Providers
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Email / Notification (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@aicareerforge.com

# Optional Third-party Services
SENTRY_DSN=
DATADOG_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
